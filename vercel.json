{
  "build": {
    "env": {
      "ENABLE_FILE_SYSTEM_API": "1"
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "src": "/user",
      "dest": "/api/user"
    },
    {
      "src": "/posts",
      "dest": "/blog"
    },
    {
      "src": "/post",
      "dest": "/blog"
    },
    {
      "src": "/oss",
      "dest": "https://github.com/6plusjp"
    },
    {
      "src": "/rss",
      "dest": "/blog/rss.xml"
    },
    {
      "src": "/feed",
      "dest": "/blog/rss.xml"
    }
  ],
  "headers": [
    {
      "source": "/build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ]
}

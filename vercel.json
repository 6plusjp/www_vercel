{
  "build": {
    "env": {
      "ENABLE_FILE_SYSTEM_API": "1"
    }
  },
  "redirects": [
    {
      "source": "/rss.xml",
      "destination": "/blog/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/blog/rss.xml",
      "permanent": true
    },
    {
      "source": "/rss",
      "destination": "/blog/rss.xml",
      "permanent": true
    },
    {
      "source": "/post/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    }
  ]
}

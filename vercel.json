{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/user",
      "destination": "/api/user"
    },
    {
      "source": "/posts",
      "destination": "/blog"
    },
    {
      "source": "/post",
      "destination": "/blog"
    },
    {
      "source": "/oss",
      "destination": "https://github.com/6plusjp"
    },
    {
      "source": "/rss",
      "destination": "/blog/rss.xml"
    },
    {
      "source": "/feed",
      "destination": "/blog/rss.xml"
    }
  ],

  "headers": [
    {
      "source": "/build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ],

  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 10 * * *"
    }
  ]
}

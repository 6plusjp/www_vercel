# Local environment variables. Copy to `.env` and fill in the values.
# `.env` is gitignored; this file is the committed template.
#
#   cp .env.example .env
#
# In production these are set in the Vercel project settings instead.

# Required. Signs the session cookie read by the theme and blog views.
# Without it the server starts but every route responds 500 with
# "SESSION_SECRET must be set". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Recommended. Seeds the spam honeypot on the contact form.
HONEYPOT_SECRET=

# Required only for /contact. Sends mail through the MailerSend API.
# Other routes are unaffected when this is unset.
MAILERSEND_API_KEY=

# Optional. The address contact form mail is sent from. When unset it falls
# back to OWNER_EMAIL in app/utils/email.server.ts.
MAIL_FROM_EMAIL=

{
  "private": true,
  "sideEffects": false,
  "name": "6plus-portfolio",
  "version": "1.0.0",
  "description": "A remix version of 6+ portfolio",
  "author": "Shoma Yamamoto <6plusjp@gmail.com> (https://6plus.tech)",
  "license": "MIT",
  "scripts": {
    "build": "npm run cleanup && run-s build:*",
    "build:css": "postcss styles --base styles --dir app/styles --env production",
    "build:remix": "remix build",
    "dev": "run-p dev:*",
    "dev:css": "postcss styles --base styles --dir app/styles -w",
    "dev:remix": "remix dev",
    "typecheck": "tsc",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "cleanup": "rimraf .cache ./build ./public/build ./app/styles",
    "reinstall": "npm run cleanup && rimraf package-lock.json pnpm-lock.yaml node_modules && npm i"
  },
  "prettier": {},
  "eslintIgnore": [
    "node_modules",
    "build",
    "public/build"
  ],
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@reach/accordion": "^0.18.0",
    "@reach/auto-id": "^0.18.0",
    "@reach/checkbox": "^0.18.0",
    "@reach/combobox": "^0.18.0",
    "@reach/menu-button": "^0.18.0",
    "@reach/rect": "^0.18.0",
    "@remix-run/css-bundle": "^1.18.1",
    "@remix-run/react": "^1.18.1",
    "@remix-run/serve": "^1.18.1",
    "@remix-validated-form/with-zod": "^2.0.6",
    "@vercel/analytics": "^1.0.1",
    "@vercel/remix": "^1.18.1",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^1.1.1",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.0",
    "esbuild": "^0.18.11",
    "framer-motion": "^6.2.8",
    "fs-extra": "^11.1.1",
    "gray-matter": "^4.0.3",
    "lodash": "^4.17.21",
    "lru-cache": "^10.0.0",
    "match-sorter": "^6.3.1",
    "mdast-util-toc": "^7.0.0",
    "mdx-bundler": "^9.2.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-external-links": "^2.1.0",
    "rehype-format": "^4.0.1",
    "rehype-parse": "^8.0.4",
    "rehype-prism-plus": "^1.4.0",
    "rehype-raw": "^6.1.1",
    "rehype-slug": "^5.0.1",
    "rehype-stringify": "^9.0.3",
    "remark-gfm": "^3.0.1",
    "remark-parse": "^10.0.1",
    "remark-rehype": "^10.1.0",
    "remark-stringify": "^10.0.2",
    "remix-validated-form": "^5.0.2",
    "tiny-invariant": "^1.2.0",
    "unified": "^10.1.2",
    "zod": "^3.17.3"
  },
  "devDependencies": {
    "@remix-run/dev": "^1.18.1",
    "@remix-run/eslint-config": "^1.18.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@types/fs-extra": "^11.0.1",
    "@types/lodash": "^4.14.181",
    "@types/react": "^17.0.24",
    "@types/react-dom": "^17.0.9",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.11.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.1.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}

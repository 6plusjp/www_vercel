{
  "private": true,
  "sideEffects": false,
  "name": "6plus-portfolio",
  "version": "1.0.0",
  "description": "A remix version of 6+ portfolio",
  "author": "Shoma Yamamoto <6plusjp@gmail.com> (https://6plus.tech)",
  "license": "MIT",
  "scripts": {
    "build": "npm run cleanup && run-s build:*",
    "build:css": "postcss styles --base styles --dir app/styles --env production",
    "build:remix": "remix build",
    "dev": "run-p dev:*",
    "dev:css": "postcss styles --base styles --dir app/styles -w",
    "dev:remix": "remix dev",
    "typecheck": "tsc",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "cleanup": "rimraf .cache ./build ./public/build ./app/styles",
    "reinstall": "npm run cleanup && rimraf package-lock.json pnpm-lock.yaml node_modules && npm i"
  },
  "prettier": {},
  "eslintIgnore": [
    "node_modules",
    "build",
    "public/build"
  ],
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@react-pdf/renderer": "^3.1.12",
    "@remix-run/css-bundle": "^2.0.1",
    "@remix-run/node": "^2.0.1",
    "@remix-run/react": "^2.0.1",
    "@remix-run/serve": "^2.0.1",
    "@remix-validated-form/with-zod": "^2.0.6",
    "@vercel/analytics": "^1.0.2",
    "@vercel/node": "^3.0.6",
    "@vercel/remix": "^2.0.1",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^2.0.0",
    "date-fns": "^2.28.0",
    "framer-motion": "^10.16.4",
    "fs-extra": "^11.1.1",
    "gray-matter": "^4.0.3",
    "isbot": "^3.7.0",
    "lodash": "^4.17.21",
    "lru-cache": "^10.0.1",
    "match-sorter": "^6.3.1",
    "mdast-util-toc": "^7.0.0",
    "mdx-bundler": "^9.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-format": "^5.0.0",
    "rehype-parse": "^9.0.0",
    "rehype-prism-plus": "^1.6.3",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remix-validated-form": "^5.1.5",
    "tiny-invariant": "^1.2.0",
    "unified": "^11.0.3",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@cld-apis/types": "^0.1.6",
    "@faker-js/faker": "^8.1.0",
    "@remix-run/dev": "^2.0.1",
    "@remix-run/eslint-config": "^2.0.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.6",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.10",
    "@types/fs-extra": "^11.0.2",
    "@types/lodash": "^4.14.199",
    "@types/react": "^18.2.23",
    "@types/react-dom": "^18.2.8",
    "autoprefixer": "^10.4.16",
    "cypress": "^13.3.0",
    "eslint": "^8.50.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.30",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.1.0",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.4",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}

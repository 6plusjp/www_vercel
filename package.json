{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "name": "6plus-portfolio",
  "version": "1.0.0",
  "description": "A remix version of 6+ portfolio",
  "author": "Shoma Yamamoto <6plusjp@gmail.com>",
  "license": "MIT",
  "overrides": {
    "axios": ">=1.13.5",
    "esbuild": ">=0.24.3",
    "estree-util-value-to-estree": ">=3.3.3",
    "nanoid": ">=3.3.8",
    "path-to-regexp": ">=6.3.0",
    "rollup": ">=2.79.2",
    "tar": ">=7.5.7",
    "undici": ">=6.23.0"
  },
  "scripts": {
    "build": "npm run cleanup && run-s build:*",
    "build:css": "postcss styles --base styles --dir app/styles --env production",
    "build:remix": "remix vite:build",
    "dev": "run-p dev:*",
    "dev:css": "postcss styles --base styles --dir app/styles -w",
    "dev:remix": "remix dev",
    "typecheck": "tsc",
    "lint": "eslint app/",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "cleanup": "rimraf .cache .vercel ./build ./public/build ./app/styles",
    "reinstall": "npm run cleanup && rimraf package-lock.json pnpm-lock.yaml node_modules && npm i"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build"
  ],
  "dependencies": {
    "@heroicons/react": "^2.1.4",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@react-pdf/renderer": "^3.4.4",
    "@remix-run/css-bundle": "2.16.7",
    "@remix-run/node": "2.16.7",
    "@remix-run/react": "2.16.7",
    "@remix-run/server-runtime": "2.16.7",
    "@remix-validated-form/with-zod": "^2.0.7",
    "@vercel/analytics": "^1.3.1",
    "@vercel/node": "^5.6.3",
    "@vercel/remix": "^2.16.7",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.2.11",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "intl-parse-accept-language": "^1.0.0",
    "is-ip": "^5.0.1",
    "isbot": "^4.4.0",
    "lodash": "^4.17.21",
    "lru-cache": "^10.2.2",
    "match-sorter": "^6.3.4",
    "mdast-util-toc": "^7.1.0",
    "mdx-bundler": "^10.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-format": "^5.0.0",
    "rehype-parse": "^9.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remix-utils": "^7.6.0",
    "remix-validated-form": "^5.1.5",
    "tiny-invariant": "^1.3.3",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cld-apis/types": "^0.1.6",
    "@faker-js/faker": "^8.4.1",
    "@mdx-js/rollup": "^3.0.1",
    "@playwright/test": "^1.46.0",
    "@remix-run/dev": "2.16.7",
    "@remix-run/eslint-config": "^2.17.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.13",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "typescript-eslint": "^7.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=8"
  }
}

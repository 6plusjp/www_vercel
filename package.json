{
  "private": true,
  "name": "6plus-portfolio",
  "version": "3.0.0",
  "description": "A remix version of 6+ portfolio",
  "author": "Shoma Yamamoto <6plusjp@gmail.com> (https://6plus.tech)",
  "license": "MIT",
  "scripts": {
    "build": "npm run cleanup && run-s build:*",
    "build:css": "postcss styles --base styles --dir app/styles --env production",
    "build:remix": "remix build",
    "dev": "run-p dev:*",
    "dev:css": "postcss styles --base styles --dir app/styles -w",
    "dev:remix": "remix dev",
    "postinstall": "remix setup node",
    "cleanup": "rimraf .cache ./api ./public/build ./app/styles",
    "reinstall": "npm run cleanup && rimraf package-lock.json node_modules && npm i"
  },
  "prettier": {},
  "eslintIgnore": [
    "node_modules",
    "build",
    "public/build",
    "api/index.js"
  ],
  "dependencies": {
    "@heroicons/react": "^1.0.6",
    "@reach/accordion": "^0.17.0",
    "@reach/auto-id": "^0.17.0",
    "@reach/checkbox": "^0.17.0",
    "@reach/combobox": "^0.17.0",
    "@reach/menu-button": "^0.17.0",
    "@reach/rect": "^0.17.0",
    "@reach/tabs": "^0.17.0",
    "@remix-run/node": "*",
    "@remix-run/react": "*",
    "@remix-run/vercel": "*",
    "@remix-validated-form/with-zod": "^2.0.1",
    "@vercel/node": "^1.15.2",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^1.1.1",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.0",
    "esbuild": "^0.12.9",
    "framer-motion": "^6.2.8",
    "fs-extra": "^10.0.1",
    "gray-matter": "^4.0.3",
    "lodash": "^4.17.21",
    "match-sorter": "^6.3.1",
    "mdast-util-toc": "^6.1.0",
    "mdx-bundler": "^9.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-format": "^4.0.1",
    "rehype-highlight": "^5.0.2",
    "rehype-parse": "^8.0.4",
    "rehype-raw": "^6.1.1",
    "rehype-slug": "^5.0.1",
    "rehype-stringify": "^9.0.3",
    "remark-gfm": "^3.0.1",
    "remark-parse": "^10.0.1",
    "remark-rehype": "^10.1.0",
    "remark-stringify": "^10.0.2",
    "remix": "*",
    "remix-validated-form": "^4.4.3",
    "shiki": "^0.10.1",
    "tiny-invariant": "^1.2.0",
    "unified": "^10.1.2",
    "zod": "^3.11.6"
  },
  "devDependencies": {
    "@cld-apis/types": "^0.1.6",
    "@remix-run/dev": "*",
    "@remix-run/eslint-config": "*",
    "@remix-run/serve": "*",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/line-clamp": "^0.3.1",
    "@tailwindcss/typography": "^0.5.2",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash": "^4.14.181",
    "@types/react": "^17.0.24",
    "@types/react-dom": "^17.0.9",
    "autoprefixer": "^10.4.4",
    "concurrently": "^7.1.0",
    "eslint": "^8.11.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.12",

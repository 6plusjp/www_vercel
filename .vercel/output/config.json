{
  "version": 3,
  "routes": [
    {
      "src": "/redirect",
      "status": 308,
      "headers": { "Location": "https://example.com/" }
    },
    {
      "src": "/user",
      "dest": "/api/user"
    },
    {
      "src": "/posts",
      "dest": "/blog"
    },
    {
      "src": "/post",
      "dest": "/blog"
    },
    {
      "src": "/oss",
      "dest": "https://github.com/6plusjp"
    },
    {
      "src": "/rss",
      "dest": "/blog/rss.xml"
    },
    {
      "src": "/feed",
      "dest": "/blog/rss.xml"
    }
  ],
  "cache": [".cache/**", "node_modules/**"]
}
